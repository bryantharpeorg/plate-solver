{
  "name": "finder-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "format": "prettier --write src e2e index.html vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src e2e index.html vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "sh scripts/e2e.sh"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@asamuzakjp/css-color": "7.1.3",
    "@babel/runtime": "7.29.7",
    "@bramus/specificity": "2.4.2",
    "tinybench": "6.2.0",
    "tldts": "7.4.16",
    "tldts-core": "7.4.16",
    "undici": "8.11.2",
    "vitest": {
      "magic-string": "1.4.2"
    },
    "@vitest/mocker": {
      "magic-string": "1.4.2"
    },
    "whatwg-url": "17.2.0"
  }
}
