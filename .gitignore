# Claude Code: local settings, skills and agents, and the app's per-session worktrees
# (.claude/worktrees/). Third-party skills such as Impeccable are installed per user, not
# vendored into this public repo.
.claude/
# Impeccable's working files: review screenshots and decision sketches stay local; the
# product record (PRODUCT.md), surface briefs and design system (DESIGN.md) are committed.
.impeccable/review/
.impeccable/mocks/

# macOS
.DS_Store

# Rust
/target

# Finder console page (NOTE: crates/finder/web/dist is committed by design: the Rust
# binary embeds it via rust-embed, so cargo builds never need node)
crates/finder/web/node_modules/
crates/finder/web/*.tsbuildinfo
crates/finder/web/test-results/
crates/finder/web/playwright-report/

# Standalone parity-capture helper crate (workspace-excluded; builds its own target)
tools/parity/_capture_binning/target/
tools/parity/_capture_binning/Cargo.lock

# Parity venvs
tools/parity/.venv
tools/parity/.venv-tetra3-orig

# feat-09 eval-harness: regenerable catalog + run output, not source
tools/parity/benchmark/generated/*.bin
tools/parity/benchmark/results.json

# Python bytecode (e.g. from running the vendored cedar-solve)
__pycache__/

# Coverage output from cargo llvm-cov (CI's test-coverage job writes it)
lcov.info

# Ergane runtime root: worktrees, session transcripts, verification evidence. One that
# reaches git history lands megabytes of agent output on the landing branch.
.ergane/
# Ergane's worktree-boundary detector writes its findings here, inside the repo it audits.
.ergane-detector/
# Ergane's legacy verification store: a live SQLite database (plus -wal/-shm) written while
# gates run. Committed mid-write it is a torn database.
.factory/

# scripts/quality.sh's pinned tools (jscpd, ESLint): npm ci installs them on first run
scripts/quality/node_modules/
